{
  "manifest_version": 3,
  "name": "DGOS Backoffice",
  "version": "1.0",
  "description": "DGOS Backoffice Chrome Extension",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api-backoffice.dgos.id/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/in/*",
        "https://linkedin.com/in/*"
      ],
      "js": ["api-client.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
